{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "build on Linux",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "${workspaceFolder}/lib/*",
                "-I",
                "${workspaceFolder}/include/",
                "-o",
                "${workspaceFolder}/build/Linux/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false,
            },
            "detail": "Task generated by Debugger."
        },
        {
            "type": "cppbuild",
            "label": "single build on Linux",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "${workspaceFolder}/lib/*",
                "-I",
                "${workspaceFolder}/include/",
                "-o",
                "${workspaceFolder}/build/Linux/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false,
            },
            "detail": "Task generated by Debugger."
        },
        {
            "type": "cppbuild",
            "label": "build on Windows",
            "command": "x86_64-w64-mingw32-g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "${workspaceFolder}/lib/*",
                "-I",
                "${workspaceFolder}/include/",
                "-std=c++17",
                "-static",
                "-o",
                "${workspaceFolder}/build/Windows/${fileBasenameNoExtension}.exe",
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Task generated by Debugger."
        },
    ],
    "version": "2.0.0"
}