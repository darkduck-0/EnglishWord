{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "compile with word.cpp and fileOpe.cpp",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "${fileDirname}/word.cpp",
                "${fileDirname}/fileOpt.cpp",
                "-I",
                "${workspaceFolder}/include/",
                "-o",
                "${workspaceFolder}/build/Linux/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true,
            },
            "detail": "Task generated by Debugger."
        },
        {
            "type": "cppbuild",
            "label": "compile with word.cpp and fileOpe.cpp on windows",
            "command": "x86_64-w64-mingw32-g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "${fileDirname}/word.cpp",
                "${fileDirname}/fileOpt.cpp",
                "-I",
                "${workspaceFolder}/include/**",
                "-o",
                "${workspaceFolder}/build/Linux/${fileBasenameNoExtension}.exe",
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Task generated by Debugger."
        },
    ],
    "version": "2.0.0"
}